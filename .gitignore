# Root .gitignore for combined Java (Maven) + Node frontend

# OS
.DS_Store
Thumbs.db

# IDEs and editors
.idea/
.vscode/

# Java / Maven
/target/
/out/
/.mvn/
*.class
*.log

# Maven generated
/dependency-reduced-pom.xml
/release.properties

# Node / frontend
/node_modules/
/dist/
/build/
/coverage/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-lock.yaml

# Vite
/node_modules/.vite/

# Python
__pycache__/
*.py[cod]

# Environment files
.env
.env.local
